# Copia aquest fitxer a .env i omple els valors

# Clau secreta de Django — genera-la amb:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=canvia-aquesta-clau-secreta

# Posar False en producció
DEBUG=False

# Hosts permesos (separat per espais). Railway afegeix automàticament el domini.
# Exemple: ALLOWED_HOSTS=espiadimonis.up.railway.app www.espiadimonis.cat
ALLOWED_HOSTS=localhost 127.0.0.1

# Base de dades — Railway injecta DATABASE_URL automàticament quan afegeixes PostgreSQL.
# Per a dev local amb SQLite, deixa-ho buit (usa SQLite per defecte).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Email SMTP (opcional, per a notificacions)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@espiadimonis.cat
# EMAIL_HOST_PASSWORD=la-contrasenya
